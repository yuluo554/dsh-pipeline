# dependencies & build output
node_modules/
lib/

# pnpm stores (never commit package caches — M5 incident 8defff4 lesson)
.clean-store/
.verify-store/
.pnpm-store/

# env & secrets (M5 发布门：git ls-files 不得出现)
.env
.env.*
*.key

# 运行产物（含流水线私有数据，M5 脱敏范围）
data/**/_private/
*.log

# npm pack 产物（M6：打 Release 附件时会在仓库根留下 .tgz，绝不入仓——
# 它由 pnpm build + npm pack 从源码重建，附件本身走 GitHub Release）
*.tgz

# OS
.DS_Store
Thumbs.db
